# The cinterop definition of the Chur C ABI.
#
# docs/interop/FFI_CONTRACT.md section 1 has Kotlin/Native reach the C ABI
# directly: cinterop reads chur.h, which is hand-written and is the authority
# for the C side, so nothing here generates a second definition of the boundary.
#
# iOS loads no JNI adapter. ADR-0040's adapter exists for Android only.

headers = chur.h
package = dev.po4yka.chur.native

// No `staticLibraries` here. A declaration in this file is resolved once, at
// cinterop time, and baked into the klib the compilation shares with every
// binary, so every framework and test executable would link the same archive
// - the debug one, whatever the binary's build type. The consuming build
// links the archive instead: `shared/app/build.gradle.kts` gives each
// framework binary and each test executable the archive of its own build
// type, and depends on the Cargo task that produces it.

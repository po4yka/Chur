<?xml version="1.0" encoding="utf-8"?>
<!--
  The primary launcher label matches the Chur icon. The public Notes shell
  keeps its own title; alternate launcher presentations require user choice.
-->
<resources>
    <string name="app_name">Chur</string>

    <!--
      The device-slot authorization of docs/security/KEY_SLOTS.md section 4.

      The words name the vault, which the public shell does not: this prompt
      only ever appears after the user has already opened the vault route, so
      it discloses nothing the surface behind it has not.
    -->
    <string name="device_slot_title">Vault</string>
    <string name="device_slot_subtitle">Confirm it\'s you to use this device\'s screen lock for the vault.</string>
    <string name="device_slot_cancel">Cancel</string>
    <!-- The device authentication of DESIGN.md section 17.1 step 2. -->
    <string name="owner_check_subtitle">Confirm it\'s you to see a new recovery phrase.</string>
    <!-- The action name does not disclose whether a vault session is open. -->
    <string name="quick_settings_lock_label">Lock Chur</string>
    <string name="quick_settings_lock_added">Lock Chur was added to Quick Settings.</string>
    <string name="quick_settings_lock_already_added">Lock Chur is already in Quick Settings.</string>
    <string name="quick_settings_lock_not_added">Lock Chur was not added. You can add it later from Quick Settings edit mode.</string>
    <string name="quick_settings_lock_manual">Open Quick Settings, tap Edit, then add Lock Chur.</string>
    <string name="quick_settings_lock_in_progress">A Quick Settings tile request is already open.</string>
    <string name="quick_settings_lock_foreground">Keep Chur open and try again to add the tile.</string>
    <string name="quick_settings_lock_unavailable">Quick Settings tiles are not available on this device.</string>
    <string name="quick_settings_lock_failed">The tile could not be added. Open Quick Settings, tap Edit, then add Lock Chur.</string>
</resources>

<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">
    <application>
        <!-- A separate test-APK provider models another app's readable share. -->
        <provider android:name="dev.po4yka.chur.android.IncomingShareFixtureProvider"
            android:authorities="dev.po4yka.chur.test.incoming-share"
            android:exported="true" android:grantUriPermissions="true" />
        <!-- A hostile decoder child for MediaDerivativeHostileChildTest. Exported so the app UID can bind it. -->
        <service android:name="dev.po4yka.chur.android.HostileDecoderService"
            android:exported="true" android:isolatedProcess="true" android:process=":hostile_decoder" />
    </application>
</manifest>

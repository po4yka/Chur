# Agent state directories. Only generated state is ignored. The vendored agent
# skills under .agents/ and .claude/ are tracked on purpose and are governed by
# the "Vendored agent skills" section of docs/DEPENDENCY_POLICY.md.
.omc/
.omo/

# Rust
/rust/target/
**/*.rs.bk

# Gradle / Kotlin / JVM
.gradle/
build/
.kotlin/
local.properties

# Android Studio / IntelliJ
.idea/
*.iml
captures/

# Xcode
DerivedData/
*.xcuserstate
xcuserdata/

# macOS
.DS_Store

# Native build intermediates
*.o
*.a
*.so
*.dylib
